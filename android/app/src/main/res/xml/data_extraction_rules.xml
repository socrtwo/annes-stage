<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later (android:dataExtractionRules): the same exclusions as backup_rules.xml
     for cloud backups and device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="quillstage.secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="quillstage.secure.xml" />
    </device-transfer>
</data-extraction-rules>
